{
    "name": "geneanet/php-gedcom",
    "description": "A GEDCOM file parser (read + write) for PHP 7.2+",
    "type": "library",
    "keywords": ["gedcom","parser"],
    "homepage": "http://github.com/geneanet/php-gedcom",
    "license": "MIT",
    "require": {
        "php": ">=7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "9.*",
        "squizlabs/php_codesniffer": "3.5.*"
    },
    "autoload": {
        "psr-4": {
            "PhpGedcom\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpGedcomTest\\": "tests/"
        }
    }
}
